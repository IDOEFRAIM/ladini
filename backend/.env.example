# ==========================================
# Application Configuration
# ==========================================
DEBUG=false
APP_ENV=dev
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434

# ==========================================
# LLM Provider Keys (Use one)
# ==========================================
# Primary - Direct Groq API Key (Recommended)
GROQ_API_KEY=gsk_xxx
# Legacy / Alternative Project Key
# AGRICONNECT_APIKEY=gsk_xxx

# ==========================================
# Database (PostgreSQL)
# ==========================================
# Example: DigitalOcean Hosted DB
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
# Example: Local Docker DB
DATABASE_URL=postgresql://postgres:change_me_in_production@localhost:5432/agribot_dev

# Docker Compose Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=agribot_dev

# ==========================================
# Redis / Celery
# ==========================================
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==========================================
# External Services (Optional)
# ==========================================
# Azure Speech (TTS/STT)
USE_AZURE_SPEECH=true
AZURE_SPEECH_KEY=
AZURE_SPEECH_KEY_2=
AZURE_REGION=westeurope
AZURE_SPEECH_ENDPOINT=https://westeurope.api.cognitive.microsoft.com/

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# LangChain / LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agriconnect
LANGSMITH_API_KEY=

# AWS (Legacy / Backup)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
REDACTED_AWS_SECRET_ACCESS_KEY
# S3_BUCKET=
