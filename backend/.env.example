# ==========================================
# Application Configuration
# ==========================================
DEBUG=false
APP_ENV=dev
# "groq" (défaut) ou "bedrock" — voir le bloc AWS plus bas. Pour bedrock,
# LLM_MODEL/LLM_MODEL_REASONING (ci-dessous) doivent être des IDs de modèle
# Bedrock valides (ex: anthropic.claude-3-5-sonnet-20241022-v2:0), pas des
# noms de modèle Groq.
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434

# ==========================================
# LLM Provider Keys (Use one)
# ==========================================
# Primary - Direct Groq API Key (Recommended)
GROQ_API_KEY=gsk_xxx
# Legacy / Alternative Project Key
# LADINI_APIKEY=gsk_xxx

# ==========================================
# Database (PostgreSQL)
# ==========================================
# Example: DigitalOcean Hosted DB
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
# Example: Local Docker DB
DATABASE_URL=postgresql://postgres:change_me_in_production@localhost:5432/agribot_dev

# Docker Compose Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=agribot_dev

# ==========================================
# Redis / Celery
# ==========================================
# CELERY_BROKER_URL/CELERY_RESULT_BACKEND vides = dérivés de REDIS_URL par
# défaut (core/settings.py::celery_broker/celery_backend) — évite 3 valeurs
# qui pourraient diverger. Ne remplir que si le broker Celery doit un jour
# vivre sur un Redis distinct de l'état applicatif (idempotence, cache).
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ==========================================
# External Services (Optional)
# ==========================================
# Azure Speech (TTS/STT)
USE_AZURE_SPEECH=true
AZURE_SPEECH_KEY=
AZURE_SPEECH_KEY_2=
AZURE_REGION=westeurope
AZURE_SPEECH_ENDPOINT=https://westeurope.api.cognitive.microsoft.com/

# --- Mode Sandbox (2026-08-27) ---
# Bascule EXPLICITE vers les environnements de test — jamais implicite via
# des clés vides. Voir core/settings.py::Settings._apply_sandbox_mode.
# true  = force PAYDUNYA_MODE=test, avertit si TWILIO_WHATSAPP_NUMBER n'est
#         pas le numéro sandbox public Twilio.
SANDBOX_MODE=true
# Remplace le SDK Groq réel par un client factice déterministe (aucune clé
# API réelle requise, aucun appel réseau) — pratique en local/CI.
MOCK_EXTERNAL_APIS=true

# --- Fournisseur de messagerie WhatsApp ---
# "whatsapp_cloud" (API Meta directe, provider par défaut) ou "twilio" (repli —
# les deux intégrations coexistent, un seul flag bascule de l'une à l'autre).
# Alias accepté : WHATSAPP_PROVIDER (mêmes valeurs, plus "meta" comme synonyme
# de "whatsapp_cloud") — voir core/settings.py::Settings._normalize_messaging_
# provider. Ne posez QU'UNE seule des deux variables (canonique OU alias).
MESSAGING_PROVIDER=whatsapp_cloud

# WhatsApp Cloud API (Meta for Developers → votre app → WhatsApp → API Setup).
# Chaque variable ci-dessous accepte aussi son alias META_* en commentaire —
# ne définissez que l'un des deux noms par variable.
# Access token permanent (System User). Alias : META_WHATSAPP_TOKEN
WHATSAPP_CLOUD_API_TOKEN=
# ID du numéro expéditeur — pendant les tests, le numéro de test Meta ; en
# production, le numéro définitif (aucun changement de code, .env seulement).
# Alias : META_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_PHONE_NUMBER_ID=
# WABA ID (gestion des templates, optionnel)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Chaîne choisie par vous, déclarée dans Meta lors de la config du webhook
# (vérification GET hub.verify_token). Alias : META_WHATSAPP_VERIFY_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Secret de l'app Meta — vérifie la signature HMAC (X-Hub-Signature-256) de
# chaque webhook entrant. SANS lui, le webhook refuse tout trafic (fail-closed).
WHATSAPP_APP_SECRET=
# Version de l'API Graph. Alias : META_GRAPH_API_VERSION
WHATSAPP_GRAPH_API_VERSION=v21.0

# Twilio (WhatsApp) — le numéro ci-dessous EST le numéro sandbox public
# Twilio (identique pour tous les comptes après avoir rejoint via le mot de
# passe sandbox de la Console Twilio) : ne PAS le remplacer par un sender de
# production tant que SANDBOX_MODE=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL publique EXACTE sous laquelle Twilio appelle le webhook (sans slash
# final). Twilio SIGNE cette URL : derrière un reverse proxy, la validation de
# signature ne peut pas la reconstruire sans cette valeur. Vide = repli sur
# X-Forwarded-Proto/Host puis sur l'URL brute de la requête.
TWILIO_PUBLIC_BASE_URL=
# Format "whatsapp:+<E164>". Alias : TWILIO_PHONE_NUMBER
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Twilio — Messages interactifs (Content API). Désactivé par défaut : à
# mettre à true UNIQUEMENT après création + approbation Meta des 2
# templates ci-dessous (audit UX interactive 2026-08-27).
TWILIO_INTERACTIVE_ENABLED=false
# ContentSid du template twilio/quick-reply (confirmation CONFIRM/REJECT)
TWILIO_CONFIRM_CONTENT_SID=
# ContentSid du template twilio/list-picker (menus à choix multiples)
TWILIO_LIST_PICKER_CONTENT_SID=

# LangChain / LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ladini
LANGSMITH_API_KEY=

# AWS — identifiants partagés par le provider LLM Bedrock (LLM_PROVIDER=bedrock
# ci-dessus) et par un futur usage S3 direct. Optionnels : si absents, boto3
# retombe sur sa propre chaîne de résolution par défaut (rôle IAM, profil
# ~/.aws/credentials...) — ne les définir explicitement que si vous n'utilisez
# pas déjà l'une de ces méthodes.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# S3_BUCKET=

# ==========================================
# MCP HTTP daemon auth (required — see infrastructure/mcp/protocols/mcp/servers/http_server.py)
# Without this set, the MCP daemon runs UNAUTHENTICATED: any client on the
# bound interface can execute any DB tool. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Setting it here configures BOTH the daemon (server) and the agent (client) at once.
# ==========================================
MCP_HTTP_AUTH_TOKEN=

# ==========================================
# LLM Gateway (2026-09-02 — voir graphs/agents/market_coach/llm_gateway/)
# Chaîne de repli par profil FAST/REASONING, format "provider:model"
# (provider ∈ groq | bedrock_gateway | bedrock_native). Vide = candidat
# absent — au moins un candidat par profil est requis. Ne pas laisser vide
# en production. Les défauts ci-dessous reflètent la config réelle au
# moment de l'introduction de cette Gateway, pas des exemples inventés.
#
# 2026-09-05 : llama-3.1-8b-instant / llama-3.3-70b-versatile décommissionnés
# par Groq le 2026-06-17 (tiers gratuit/développeur) — remplacés par les
# repli RECOMMANDÉS PAR GROQ (console.groq.com/docs/deprecations),
# openai/gpt-oss-20b et openai/gpt-oss-120b. Si votre .env local définit
# encore les anciennes valeurs, mettez-le à jour manuellement — ce fichier
# n'est qu'un template, jamais lu directement en production.
# ==========================================
LLM_FAST_PRIMARY=bedrock_gateway:qwen.qwen3-32b
LLM_FAST_FALLBACK_1=groq:openai/gpt-oss-20b
LLM_FAST_FALLBACK_2=
LLM_REASONING_PRIMARY=bedrock_gateway:deepseek.v3.2
LLM_REASONING_FALLBACK_1=bedrock_gateway:openai.gpt-oss-120b
LLM_REASONING_FALLBACK_2=groq:openai/gpt-oss-120b
# Disjoncteur partagé (Redis) — CLOSED/OPEN/HALF_OPEN par (provider, modèle).
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_HALF_OPEN_PROBES=1
LLM_PROBE_LOCK_SECONDS=10
# Budget total (tous candidats/repli confondus) par profil, en secondes.
LLM_FAST_BUDGET_SECONDS=12
LLM_REASONING_BUDGET_SECONDS=20
# Webhook générique (payload compatible Slack Incoming Webhook) pour les
# alertes d'incident LLM (circuit OPEN, provider down...). Vide = alertes en
# log structuré uniquement, aucun canal réel configuré.
ADMIN_ALERT_WEBHOOK_URL=
# Auth de GET /admin/llm/health (header X-Admin-Token). Vide = endpoint
# refusé par défaut (fail-closed) — jamais exposé sans authentification.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Auth des routes internes /api/market/* (header X-Internal-Token).
# ⚠️ Ces routes lancent l'agent pour un phone_number ARBITRAIRE avec
# force_role=True : sans ce token, n'importe qui agit comme n'importe quel
# utilisateur (commander, confirmer, annuler) sans passer par WhatsApp.
# Vide = routes refusées par défaut (fail-closed).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ── Cockpit /admin/monitoring : télémétrie des tours de l'agent ─────────────────────────────────
# (docs/monitoring/COCKPIT.md) Chaque message traité est journalisé dans PostgreSQL (tables intelligence.agent_turns,
# agent_tool_calls, agent_llm_calls) pour alimenter le cockpit admin. Best-effort : n'affecte jamais la réponse utilisateur.
# Interrupteur général. false = plus aucune écriture de télémétrie (le cockpit devient vide).
AGENT_MONITORING_ENABLED=true
# Durée de conservation des tours, en jours. Une purge Celery Beat (toutes les 6 h) supprime les plus anciens.
# Une valeur < 1 est IGNORÉE par sécurité (elle ne peut pas vider la table).
AGENT_MONITORING_RETENTION_DAYS=30
# Écart maximal (minutes) entre deux messages d'un même utilisateur pour rester dans la même « session » du cockpit.
AGENT_MONITORING_SESSION_GAP_MINUTES=30
# Temps maximal (secondes) accordé à l'écriture d'un tour en base ; au-delà, l'écriture est abandonnée (le message, lui,
# est déjà parti). Garde la télémétrie hors du chemin critique.
AGENT_MONITORING_WRITE_TIMEOUT_SECONDS=2.0
# SECRET — « poivre » du hash des numéros de téléphone. Les numéros ne sont JAMAIS stockés en clair : on stocke un HMAC-SHA256
# (pour regrouper les messages d'un même utilisateur) + les 4 derniers chiffres (pour afficher +226 •••• 4582).
# Sans poivre, le hash d'un numéro serait retrouvable par énumération (l'espace de numérotation est petit).
# À GÉNÉRER UNE FOIS et à garder stable : le changer casse le regroupement des sessions déjà enregistrées (pas les données).
# Ne JAMAIS le committer. Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vide = repli dérivé de DATABASE_URL (fonctionne, mais moins isolé : à éviter en production).
AGENT_MONITORING_PHONE_PEPPER=
