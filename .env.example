# ═════════════════════════════════════════════════════════════════════
# AgriConnect — .env.example (PRODUCTION / docker-compose.prod.yml)
# Copiez en `.env` à la racine et remplissez. NE COMMITTEZ JAMAIS le .env réel.
# Générez les secrets : openssl rand -hex 32
# ═════════════════════════════════════════════════════════════════════

# ── LLM (Groq) ───────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxx

# ── Base de données applicative (Postgres derrière PgBouncer) ─────────
POSTGRES_USER=agriconnect
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=agriconnect
# NB : l'app construit DATABASE_URL vers pgbouncer:6432 dans le compose ;
# override manuel possible ici si vous ciblez une DB managée externe.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:6432/db

# ── Redis (broker Celery + cache Langfuse db 1) ──────────────────────
REDIS_URL=redis://redis:6379/0

# ── Twilio / WhatsApp ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Messages interactifs (boutons/listes) — requiert un Sender de PRODUCTION.
TWILIO_INTERACTIVE_ENABLED=false
TWILIO_CONFIRM_CONTENT_SID=

# ── Flower (monitoring Celery — protégé par auth basique) ────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_strong

# ── Observabilité INFRA : OpenTelemetry + Prometheus ─────────────────
OTEL_ENABLED=true
# Endpoint OTLP/gRPC d'un collector (Grafana Alloy, otel-collector, Tempo…).
# Laissez vide pour n'activer que les spans locaux sans export.
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true

# ── LLMOps : Langfuse (côté APPLICATION) ─────────────────────────────
LANGFUSE_ENABLED=true
# Clés projet créées dans l'UI Langfuse (Settings → API Keys) APRÈS 1er boot.
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# (LANGFUSE_HOST est fixé à http://langfuse-web:3000 dans le compose interne.)

# ── Langfuse self-host v3 : INFRASTRUCTURE ───────────────────────────
# URL publique de l'UI Langfuse (pour NextAuth).
LANGFUSE_PUBLIC_URL=http://localhost:3000
# Secrets Langfuse (openssl rand -hex 32 ; ENCRYPTION_KEY = hex 64 exact).
LANGFUSE_NEXTAUTH_SECRET=change_me_hex32
LANGFUSE_SALT=change_me_hex32
LANGFUSE_ENCRYPTION_KEY=change_me_hex64
# DB dédiée Langfuse (séparée de la DB applicative).
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change_me_strong
LANGFUSE_DB_NAME=langfuse
# ClickHouse (analytics Langfuse v3).
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=change_me_strong
# MinIO (stockage S3 des évènements Langfuse v3).
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=change_me_strong
MINIO_BUCKET=langfuse-events
