# ═════════════════════════════════════════════════════════════════════
# Ladini — .env.example (PRODUCTION / docker-compose.prod.yml)
# Copiez en `.env` à la racine et remplissez. NE COMMITTEZ JAMAIS le .env réel.
# Générez les secrets : openssl rand -hex 32
#
# Les variables marquées [REQUIS] sont référencées avec `:?` dans
# docker-compose.prod.yml : si elles manquent, `docker compose` refuse de
# démarrer avec un message explicite, plutôt que de lancer un service en
# configuration dégradée silencieuse.
# ═════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════
# RELEASE — build-once / run-everywhere (hardening DevOps 2026-09-10)
# ═════════════════════════════════════════════════════════════════════
# Registry des images immuables. GHCR par défaut ; provider-neutral —
# passer à ECR / Docker Hub = changer ces 2 valeurs, PAS le compose.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=idoefraim/agriconnect
# RELEASE_VERSION n'est PAS mis ici : il est fourni par `scripts/deploy.sh
# <release>` (un tag immuable `sha-…`, jamais `latest`). Le laisser vide.
# RELEASE_VERSION=

# ── Secrets d'infrastructure interne [REQUIS] ────────────────────────
# Mot de passe Redis. Redis porte le broker Celery (une tâche injectée =
# exécution de code métier arbitraire), le disjoncteur partagé du LLM
# Gateway, le cache de recherche et les verrous d'idempotence des webhooks.
# Générer : openssl rand -hex 32
REDIS_PASSWORD=change_me_hex32
# Plafond mémoire Redis. Politique = `noeviction` (voir compose) : sous
# pression, Redis REFUSE les écritures au lieu d'évincer des tâches/verrous.
# Surveiller `used_memory_human` (docs/runbooks/incident.md → "Redis OOM").
REDIS_MAXMEMORY=512mb
# Secret partagé entre le daemon MCP et ses clients (api/worker). Le daemon
# expose POST /mcp qui exécute n'importe quel outil DB et dérive l'identité
# de l'appelant depuis le payload — sans ce token, quiconque atteint le port
# agit comme n'importe quel utilisateur.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HTTP_AUTH_TOKEN=change_me_token
# Auth de GET /admin/llm/health (header X-Admin-Token). Vide = endpoint
# refusé par défaut (fail-closed) — laisser vide si vous ne l'utilisez pas.
ADMIN_API_TOKEN=
# Auth des routes internes /api/market/* (header X-Internal-Token).
# ⚠️ Ces routes lancent l'agent pour un phone_number ARBITRAIRE avec
# force_role=True : sans ce token, n'importe qui agit comme n'importe quel
# utilisateur (commander, confirmer, annuler) sans passer par WhatsApp.
# Vide = routes refusées par défaut (fail-closed).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────
# Liste JSON des origines autorisées. `[]` = aucune origine navigateur
# (correct pour un backend piloté par webhooks). Ne JAMAIS mettre ["*"] en
# production. Ex : ["https://app.ladini.com"]
ALLOWED_ORIGINS=[]

# ── LLM : clés fournisseurs ──────────────────────────────────────────
# Groq [REQUIS] — utilisé comme repli par le LLM Gateway même quand le
# candidat primaire est Bedrock.
GROQ_API_KEY=gsk_xxx
# Passerelle Bedrock compatible OpenAI (AWS Bedrock API keys). Requis par
# tout candidat `bedrock_gateway:*` ci-dessous.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── LLM Gateway : chaîne de repli par profil ─────────────────────────
# Format "provider:model" (provider ∈ groq | bedrock_gateway | bedrock_native).
# Vide = candidat absent. Au moins un candidat par profil est requis.
LLM_FAST_PRIMARY=bedrock_gateway:qwen.qwen3-32b
LLM_FAST_FALLBACK_1=groq:openai/gpt-oss-20b
LLM_FAST_FALLBACK_2=
LLM_REASONING_PRIMARY=bedrock_gateway:deepseek.v3.2
LLM_REASONING_FALLBACK_1=bedrock_gateway:openai.gpt-oss-120b
LLM_REASONING_FALLBACK_2=groq:openai/gpt-oss-120b
# Disjoncteur partagé (Redis) — CLOSED/OPEN/HALF_OPEN par (provider, modèle).
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_HALF_OPEN_PROBES=1
LLM_PROBE_LOCK_SECONDS=10
# Budget total (tous replis confondus) par profil, en secondes.
LLM_FAST_BUDGET_SECONDS=12
LLM_REASONING_BUDGET_SECONDS=20
# Webhook d'alerte incident LLM (payload compatible Slack). Vide = logs seuls.
ADMIN_ALERT_WEBHOOK_URL=

# ── Base de données applicative (Postgres managé, DERRIÈRE PgBouncer) ─
# [REQUIS] Composants séparés (PAS une URL complète) : l'image
# edoburu/pgbouncer génère pgbouncer.ini par variables d'env.
#
# CONVENTION PROVIDER-NEUTRAL (hardening DevOps 2026-09-10) : utilisez
# `DB_*`. Le compose lit `${DB_HOST:-${DO_DB_HOST}}` etc. → les anciens
# `DO_DB_*` restent acceptés en repli pour ne pas casser les hôtes déjà
# déployés. Migrez vers `DB_*` et retirez `DO_DB_*` plus tard.
DB_HOST=your-cluster.example.com
DB_PORT=25060
DB_USER=ladini_app
DB_PASSWORD=change_me
DB_NAME=ladini
# ── Repli LEGACY (à supprimer une fois DB_* en place partout) ────────
# DO_DB_HOST=
# DO_DB_PORT=25060
# DO_DB_USER=
# DO_DB_PASSWORD=
# DO_DB_NAME=
# Connexions RÉELLES que pgbouncer ouvre vers le cluster (PAS les connexions
# app → pgbouncer, celles-ci sont poolées) — DOIT rester <= max_connections
# de votre plan managé moins une marge (~10) pour les connexions admin.
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Pool SQLAlchemy PAR PROCESS applicatif (api/worker/mcp) — resserré car
# PgBouncer absorbe déjà le fan-in.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ── Fournisseur de messagerie WhatsApp ────────────────────────────────
# "whatsapp_cloud" (API Meta directe, recommandé) ou "twilio" (repli).
MESSAGING_PROVIDER=whatsapp_cloud

# ── WhatsApp Cloud API (Meta directe) ─────────────────────────────────
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Chaîne que VOUS choisissez et déclarez côté Meta (vérification GET initiale).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
# Secret de l'app Meta — vérifie la signature HMAC de CHAQUE webhook entrant.
# Sans lui, n'importe qui peut poster un faux message sur l'endpoint.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_NATIVE_INTERACTIVE_ENABLED=true

# ── Twilio / WhatsApp (repli — voir MESSAGING_PROVIDER) ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL publique EXACTE sous laquelle Twilio appelle le webhook (sans slash
# final). Twilio SIGNE cette URL : derrière un reverse proxy, la validation de
# signature ne peut pas la reconstruire sans cette valeur. Vide = repli sur
# X-Forwarded-Proto/Host puis sur l'URL brute de la requête.
TWILIO_PUBLIC_BASE_URL=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Messages interactifs (boutons/listes) — requiert un Sender de PRODUCTION.
TWILIO_INTERACTIVE_ENABLED=false
TWILIO_CONFIRM_CONTENT_SID=
TWILIO_LIST_PICKER_CONTENT_SID=

# ── Supabase Storage (photos produits reçues par WhatsApp) ───────────
SUPABASE_URL=
# Clé SERVICE ROLE (jamais la clé anon) — upload serveur à serveur.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_BUCKET=ladini

# ── Paydunya (Escrow paiement séquestre) ─────────────────────────────
# false = précommande confirmée directement, paiement à la livraison.
ESCROW_PAYMENT_ENABLED=false
PUBLIC_API_BASE_URL=https://api.ladini.example.com
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
PAYDUNYA_PAYMENT_TTL_HOURS=24

# ── Flower (monitoring Celery) [REQUIS] ──────────────────────────────
# Publié sur 127.0.0.1 uniquement (accès par tunnel SSH :
#   ssh -L 5555:127.0.0.1:5555 user@hote).
# Le compose échoue si ces deux valeurs manquent : une auth basique vide
# rendrait le tableau de bord (arguments de tâches = téléphones, montants,
# et droit de révoquer une tâche) totalement public.
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_strong

# ── Observabilité INFRA : OpenTelemetry + Prometheus ─────────────────
OTEL_ENABLED=true
# Endpoint OTLP/gRPC d'un collector (Grafana Alloy, otel-collector, Tempo…).
# Laissez vide pour n'activer que les spans locaux sans export.
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
# Sentry (erreurs applicatives). Vide = désactivé.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── LLMOps : Langfuse Cloud ──────────────────────────────────────────
# La stack Langfuse self-hosted (clickhouse/minio/langfuse-*) a été RETIRÉE
# du compose ("Version Allégée") : seules ces 3 variables restent utiles.
# LANGFUSE_HOST est fixé à https://cloud.langfuse.com dans le compose.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
