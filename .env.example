# ═════════════════════════════════════════════════════════════════════
# AgriConnect — .env.example (PRODUCTION / docker-compose.prod.yml)
# Copiez en `.env` à la racine et remplissez. NE COMMITTEZ JAMAIS le .env réel.
# Générez les secrets : openssl rand -hex 32
# ═════════════════════════════════════════════════════════════════════

# ── LLM (Groq) ───────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxx

# ── Base de données applicative (Postgres managé DigitalOcean, DERRIÈRE
# PgBouncer local — voir service `pgbouncer` de docker-compose.prod.yml) ──
# Composants séparés (PAS une URL complète) : pgbouncer.ini est généré par
# variables d'env par l'image edoburu/pgbouncer, il ne parse pas d'URL.
# Valeurs dans DigitalOcean → Databases → votre cluster → Connection Details.
DO_DB_HOST=your-cluster.db.ondigitalocean.com
DO_DB_PORT=25060
DO_DB_USER=doadmin
DO_DB_PASSWORD=change_me
DO_DB_NAME=your_db
# Connexions RÉELLES que pgbouncer ouvre vers DO (PAS les connexions
# app → pgbouncer, celles-ci sont poolées) — DOIT rester <= max_connections
# de votre plan DO managé moins une marge (~10) pour les connexions
# admin/DO internes. Vérifiez Databases → Settings dans la console DO.
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Pool SQLAlchemy PAR PROCESS applicatif (api/worker/mcp) — resserré car
# PgBouncer absorbe déjà le fan-in ; voir le calcul en commentaire dans
# docker-compose.prod.yml (x-app-env).
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ── Redis (broker Celery + cache Langfuse db 1) ──────────────────────
REDIS_URL=redis://redis:6379/0

# ── Fournisseur de messagerie WhatsApp ────────────────────────────────
# "whatsapp_cloud" (API Meta directe, recommandé) ou "twilio" (repli).
MESSAGING_PROVIDER=whatsapp_cloud

# ── WhatsApp Cloud API (Meta directe) ─────────────────────────────────
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_NATIVE_INTERACTIVE_ENABLED=true

# ── Twilio / WhatsApp (repli — voir MESSAGING_PROVIDER) ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Messages interactifs (boutons/listes) — requiert un Sender de PRODUCTION.
TWILIO_INTERACTIVE_ENABLED=false
TWILIO_CONFIRM_CONTENT_SID=

# ── Paydunya (Escrow paiement séquestre) ─────────────────────────────
# false = précommande confirmée directement, paiement à la livraison.
ESCROW_PAYMENT_ENABLED=false
PUBLIC_API_BASE_URL=https://api.ladini.example.com
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
PAYDUNYA_PAYMENT_TTL_HOURS=24

# ── Flower (monitoring Celery — protégé par auth basique) ────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_strong

# ── Observabilité INFRA : OpenTelemetry + Prometheus ─────────────────
OTEL_ENABLED=true
# Endpoint OTLP/gRPC d'un collector (Grafana Alloy, otel-collector, Tempo…).
# Laissez vide pour n'activer que les spans locaux sans export.
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true

# ── LLMOps : Langfuse (côté APPLICATION) ─────────────────────────────
LANGFUSE_ENABLED=true
# Clés projet créées dans l'UI Langfuse (Settings → API Keys) APRÈS 1er boot.
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# (LANGFUSE_HOST est fixé à http://langfuse-web:3000 dans le compose interne.)

# ── Langfuse self-host v3 : INFRASTRUCTURE ───────────────────────────
# URL publique de l'UI Langfuse (pour NextAuth).
LANGFUSE_PUBLIC_URL=http://localhost:3000
# Secrets Langfuse (openssl rand -hex 32 ; ENCRYPTION_KEY = hex 64 exact).
LANGFUSE_NEXTAUTH_SECRET=change_me_hex32
LANGFUSE_SALT=change_me_hex32
LANGFUSE_ENCRYPTION_KEY=change_me_hex64
# DB dédiée Langfuse (séparée de la DB applicative).
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change_me_strong
LANGFUSE_DB_NAME=langfuse
# ClickHouse (analytics Langfuse v3).
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=change_me_strong
# MinIO (stockage S3 des évènements Langfuse v3).
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=change_me_strong
MINIO_BUCKET=langfuse-events
