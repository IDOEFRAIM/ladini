# Identifiants Grafana Cloud — SEUL le conteneur `alloy` les reçoit (voir
# README.md §"least privilege"). Ne JAMAIS copier ces variables dans
# docker-compose.prod.yml (api/worker/mcp/flower).
#
# Récupération recommandée : Grafana Cloud > Connections > Add new
# connection > "Alloy" (ou "Hosted Prometheus metrics" / "Hosted Logs" pour
# les récupérer séparément) — l'onboarding génère un snippet prêt à
# copier-coller avec CES MÊMES noms de variable. Voir README.md.

GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-XX-XXXX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=000000
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-XX-prod-XX-XXXX.grafana.net/otlp
GRAFANA_CLOUD_OTLP_INSTANCE_ID=000000
# Clé API Grafana Cloud (scope minimal : metrics:write, logs:write, traces:write)
GRAFANA_CLOUD_API_KEY=change_me
