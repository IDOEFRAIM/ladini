# Broker Celery (Redis externe partagé, même valeur que REDIS_URL/
# CELERY_BROKER_URL dans docker-compose.prod.yml) — celery-exporter
# consomme les événements Celery directement depuis ce broker.
CELERY_BROKER_URL_FOR_EXPORTER=rediss://default:change_me@your-redis-host:6379/0

# Même Redis externe que l'appli (docker-compose.prod.yml).
REDIS_URL=rediss://default:change_me@your-redis-host:6379/0

# DSN PgBouncer — se connecte à la base virtuelle `pgbouncer` exposée par
# PgBouncer lui-même (SHOW STATS/SHOW POOLS), pas à Postgres directement.
# Utilisateur/mdp = ceux déjà configurés côté PgBouncer (DB_USER/DB_PASSWORD
# dans docker-compose.prod.yml) — PgBouncer expose la base admin `pgbouncer`
# aux mêmes identifiants applicatifs par défaut (AUTH_TYPE=scram-sha-256).
PGBOUNCER_EXPORTER_DSN=postgres://change_me:change_me@pgbouncer:6432/pgbouncer?sslmode=disable
