FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend/src

WORKDIR /app

# Runtime dependencies for the ingestion worker (AWS + parsing + DB + vectors)
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev build-essential curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    boto3 \
    requests \
    pydantic \
    pydantic-settings \
    sqlalchemy \
    psycopg2-binary \
    pgvector \
    tqdm \
    pypdf \
    beautifulsoup4

COPY backend/src /app/backend/src
COPY backend/sources /app/backend/sources

RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["python", "-m", "ladini.domain.ingestion.worker", "--mode", "harvest", "--max-queue-items", "0"]
