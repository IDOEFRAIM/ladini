# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────
# Image Worker Celery. Réutilise EXACTEMENT le même build que l'API
# (Dockerfile.api builder) — seule la commande de lancement change.
# On repart de l'image API construite pour éviter de recompiler les deps.
# ─────────────────────────────────────────────────────────────────────
ARG API_IMAGE=ladini-api:latest
FROM ${API_IMAGE} AS runtime

# (2026-09-17, follow-up pre-Hetzner) — BUG RÉEL trouvé en E2E local, pas
# seulement documenté : `beat` (docker-compose.prod.yml) monte un volume
# NOMMÉ sur `/var/lib/celery-beat` pour survivre à un redémarrage — mais ce
# répertoire n'existait NULLE PART dans cette image avant ce commit, donc
# Docker le crée au premier montage avec le propriétaire par défaut
# (root:root, 755). `appuser` (uid 10001, ligne `USER` ci-dessous) ne peut
# alors JAMAIS écrire `celerybeat-schedule` — `_gdbm.error: [Errno 13]
# Permission denied`, à CHAQUE démarrage, crash immédiat, `restart:
# unless-stopped` relance en boucle indéfiniment (observé : 170+ redémarrages
# en ~5h de validation E2E). Le healthcheck (`pgrep`) masquait partiellement
# le problème : "healthy" entre deux crashs très rapprochés donnait
# l'illusion d'un service stable. Créer le répertoire ICI, avant `USER`, avec
# le bon propriétaire : Docker initialise un volume nommé VIDE en copiant le
# contenu (et les permissions) du répertoire de l'image au même chemin — la
# correction doit donc vivre dans l'image, pas seulement dans le compose.
# `USER root` explicite : l'image API de base bascule déjà sur `appuser` en
# fin de son propre Dockerfile — sans ce retour à root, `mkdir /var/lib/...`
# échoue lui-même en Permission denied (confirmé en E2E local).
USER root
RUN mkdir -p /var/lib/celery-beat && chown -R appuser:appuser /var/lib/celery-beat

USER appuser
WORKDIR /app/backend/src

# tini hérité de l'image API (déjà installé + ENTRYPOINT) — Celery prefork
# EN PARTICULIER a besoin d'un reaper PID 1 fiable : le process "celery
# worker" est lui-même un parent qui fork N enfants (concurrency) ; si PID 1
# ne reap pas correctement, un enfant prefork recyclé (--max-tasks-per-child)
# ou tué peut laisser un zombie qui s'accumule sur la durée de vie longue du
# conteneur.

# Pas de port exposé (le worker ne sert pas de HTTP).
#
# Healthcheck : LIVENESS uniquement (process vivant), PAS un ping broker.
# (2026-09-18, audit smoke Celery — incident sha-6af07e0) : cette directive
# utilisait auparavant `celery inspect ping -d "celery@$(hostname)"` — DEUX
# défauts distincts, trouvés en auditant pourquoi le worker semblait KO en
# smoke test alors qu'il tournait normalement :
#   1. `-d "celery@$(hostname)"` cible un NOM DE DESTINATION précis — fragile
#      par construction (dépend que $(hostname), résolu À CHAQUE probe dans
#      un NOUVEAU shell, corresponde exactement au nodename que le worker a
#      choisi À SON DÉMARRAGE ; aucune garantie forte de ce côté, et aucun
#      besoin de cibler un worker précis pour une question de liveness — voir
#      lib.sh::celery_worker_ping, qui ping en BROADCAST pour la même raison).
#   2. `docker-compose.prod.yml` (service `worker`) écrase de toute façon
#      cette directive avec la MÊME logique pgrep (+marqueur, voir ci-dessous)
#      depuis l'audit hardening 2026-09-10 (`celery inspect ping` en
#      HEALTHCHECK redémarrait TOUS les workers en boucle pendant un simple
#      hoquet Redis) — ce qui précède était donc du CODE MORT en production,
#      mais restait le comportement par défaut si jamais cette image tournait
#      SANS ce compose (`docker run` direct, autre orchestrateur) : dangereux
#      de laisser un défaut fragile/trompeur. Alignée ici sur la MÊME logique
#      que le compose, pour un comportement sain par défaut dans tous les cas.
#
# (2026-09-18, incident réel sha-891cb2f — worker crash-loopait sur une
# ValueError TLS Redis au boot, mais `pgrep` seul le rapportait "healthy") :
# `pgrep` prouve qu'UN process correspondant existe À L'INSTANT de la probe —
# pas qu'il a fini de démarrer. Un crash-loop rapide (process créé, crashe
# avant l'event loop, conteneur relancé par `restart: unless-stopped`, repeat)
# laisse une fenêtre où `pgrep` attrape un process "vivant" qui n'a en réalité
# JAMAIS atteint un état fonctionnel. Fix : exige EN PLUS l'existence du
# marqueur écrit par `celery.signals.worker_ready` (api/celery_app.py) — ce
# signal ne se déclenche qu'APRÈS une connexion broker+backend réussie et le
# mingle terminé, donc jamais pendant un crash au boot. Toujours zéro
# round-trip broker sur CHAQUE probe (juste `test -f`) — aussi bon marché et
# insensible à un hoquet Redis transitoire que `pgrep` seul, mais qui ne peut
# plus mentir sur un crash-loop au démarrage.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD sh -c 'pgrep -f "celery.*worker" >/dev/null && test -f "${CELERY_WORKER_READY_FILE:-/tmp/celery_worker_ready}"' || exit 1

# --- Tuning Celery : charge 100% I/O-bound (appels LLM Groq, MCP HTTP,
# webhooks WhatsApp/Twilio, requêtes DB via pgbouncer) — AUCUNE tâche
# CPU-bound dans ce worker (pas de torch/embeddings synchrones dans le
# hot-path Celery, voir workers/). Ça dicte tous les choix ci-dessous :
#
# --pool=prefork (PAS gevent/eventlet) : chaque process Celery `worker_init`
#   ouvre SA PROPRE boucle asyncio persistante (voir api/tasks.py::_loop) et
#   exécute chaque tâche via `run_until_complete` — un pool gevent/eventlet
#   fait du monkey-patching coopératif qui ENTRE EN CONFLIT avec une boucle
#   asyncio déjà présente dans le même process (deux runtimes de concurrence
#   différents, pas composables sans pont dédié type `asyncio-gevent`). Le
#   prefork isole aussi CHAQUE tâche dans un process séparé : si une tâche
#   segfault sur un binding C foireux (ex: torch, pgvector), un seul child
#   meurt, pas tout le worker.
#
# --concurrency=4 : PAS dimensionné sur les cœurs CPU (charge I/O-bound =
#   la plupart du temps chaque process ATTEND un appel réseau, pas de calcul).
#   Dimensionné plutôt sur (a) la mémoire dispo par conteneur — chaque child
#   charge langgraph/langchain + pool DB chaud, budget ~350-500MB/enfant
#   observé, donc 4 childs tient dans une limite mémoire de 2GB avec marge —
#   et (b) le nombre de connexions DB qu'il ouvre (chaque child = 1 pool
#   SQLAlchemy chaud, voir DB_POOL_SIZE/pgbouncer). PRÉFÉRER scaler par
#   RÉPLICAS de conteneurs (`docker compose up --scale worker=N` / Swarm
#   `deploy.replicas`) plutôt que de pousser concurrency très haut dans un
#   seul conteneur : blast radius plus petit si OOM/crash, et redémarrage
#   d'un conteneur ne perd que 4 tâches en vol (task_acks_late=True dans
#   celery_app.py les fait de toute façon redéliverer, jamais perdues).
#
# --max-tasks-per-child=200 : recycle chaque process après 200 tâches — filet
#   de sécurité contre les fuites mémoire lentes (objets LangChain/LangGraph,
#   connexions fantômes) sur un process qui vit potentiellement des jours.
# --max-memory-per-child=450000 (Ko, ~450MB) : filet INDÉPENDANT du nombre de
#   tâches — tue+respawn un child dès qu'il dépasse ce seuil RSS, avant qu'il
#   ne mette la pression sur les autres childs du même conteneur (et avant
#   que le conteneur entier ne se fasse OOM-killer par le noyau, ce qui
#   tuerait TOUS les childs d'un coup au lieu d'un seul).
#
# -Ofair : désactive l'optimisation "early ack" par défaut de prefork —
#   combiné à `worker_prefetch_multiplier=1` (celery_app.py), garantit une
#   distribution round-robin équitable des tâches entre les 4 enfants même
#   quand certaines tâches (appel LLM lent) durent bien plus longtemps que
#   d'autres. Sans ça, un enfant peut se retrouver à accumuler une file
#   pendant qu'un autre est libre.
CMD ["celery", "-A", "ladini.api.celery_app", "worker", \
     "--loglevel=info", "-Ofair", \
     "--concurrency=4", "--pool=prefork", \
     "--max-tasks-per-child=200", "--max-memory-per-child=450000"]
