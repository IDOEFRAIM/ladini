# Verrous réels (répertoires créés par `mkdir`, voir scripts/lib.sh) — les
# `*.lock` ci-dessous sont des noms de base historiques, jamais créés tels
# quels ; seuls les `*.lockdir` le sont (2026-09-18, audit lock cluster/node).
deploy/.deploy.lock
deploy/.deploy.lockdir
deploy/.cluster-deploy.lock
deploy/.cluster-deploy.lockdir

